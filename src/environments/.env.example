# Kopiraj u .env i popuni vrednostima za svoje okruzenje:
#   cp src/environments/.env.example src/environments/.env

PORT=3000

# Podrazumevane vrednosti odgovaraju kontejneru iz database/database.sh
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=computer_shop
DATABASE_USER=root
DATABASE_PASSWORD=change-me

# Tajni kljuc za potpisivanje JWT tokena - postavi dugacku nasumicnu vrednost
JWT_SECRET=change-me
